# =============================================================================
# Meridian AMS — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# Required  — app refuses to start if missing or invalid.
# Optional  — has a safe default, override only when needed.
# Computed  — derived automatically from other variables, do not set directly.
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

[Required] 
# Controls logging format, cookie security, API docs, and Prometheus.
# Allowed: development | test | staging | production
# staging behaves identically to production for all security settings.
ENVIRONMENT=development

[Optional] 
# Accepted Host header values — enforced in staging and production
# to block host header injection. Include your Railway domain and any custom
# domain. Comma-separated.
ALLOWED_HOSTS=localhost,127.0.0.1

[Optional] 
# Origins permitted to make cross-origin requests. Never use *.
# Add your frontend dev server and production URL. Comma-separated.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# DATABASE_URL is computed from these values — do not set it directly.
# On Railway, use the individual variables injected by the managed PostgreSQL
# add-on rather than a full connection string.

[Required]
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PSSW=your_database_password
DB_NAME=your_database_name

[Optional] 
# Tune based on expected concurrent load.
# pool_size: persistent connections kept open.
# max_overflow: additional connections allowed under peak load.
# pool_recycle: seconds before a connection is recycled (prevents stale conns).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600


# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# REDIS_URL is computed from these values — do not set it directly.

[Required]
REDIS_HOST=localhost
REDIS_PORT=6379

[Optional]
# Leave blank for local development without auth.
REDIS_PASSWORD=

[Optional]
# Use a separate DB index per environment to prevent data bleed.
# Convention: 0 = development, 1 = test, 2 = staging.
REDIS_DB=0


# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------

[Required]
# Signs and verifies all JWT tokens.
# Generate: openssl rand -hex 64
# Never reuse across environments.
JWT_SECRET_KEY=your_jwt_secret_key_minimum_32_characters_long

[Optional]
# Set only during JWT secret rotation. Accepts tokens signed with
# the old key for one access token lifetime (15 min), then remove it.
JWT_SECRET_KEY_PREVIOUS=your_jwt_secret_key_minimum_32_characters_long

[Optional]
# Keep short — refresh tokens handle session continuity.
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

[Optional]
# Grace window for concurrent tab refresh races (seconds).
# Both tabs return the same new token instead of triggering family invalidation.
REFRESH_GRACE_WINDOW_SECONDS=120

[Required]
# Signs cursor pagination tokens — tampered cursors are rejected 422.
# Generate: openssl rand -hex 32
CURSOR_SECRET_KEY=your_cursor_secret_minimum_32_characters_long


# -----------------------------------------------------------------------------
# Users
# -----------------------------------------------------------------------------

[Required]
# Email domain enforced for all WORK account registrations.
WORK_EMAIL_DOMAIN=school.edu

[Optional]
# Account lockout policy after repeated failed login attempts.
MAX_LOGIN_ATTEMPTS=10
LOCKOUT_DURATION_MINUTES=60


# -----------------------------------------------------------------------------
# Grading
# -----------------------------------------------------------------------------

[Optional]
# Determines which term types are valid when creating Terms.
# Allowed: semester | quarter | trimester
GRADING_PERIOD_TYPE=semester


# -----------------------------------------------------------------------------
# Workers
# -----------------------------------------------------------------------------

[Optional]
# How often the email worker polls for pending outbox rows (seconds).
EMAIL_WORKER_INTERVAL=30

[Optional] 
# How often the deletion worker sweeps for accounts past their
# grace period (seconds). Default is 1 hour.
DELETION_WORKER_INTERVAL=3600


# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
# Used for activation invites, forgot-password, and reset-password flows only.
# All operational notifications are delivered in-app, not via email.

# Optional in development. Required in staging and production.
EMAIL_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

[Optional] 
# Must be a verified sender address with your email provider.
MAIL_FROM=noreply@school.edu

[Optional]
MAIL_FROM_NAME=Meridian AMS


# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------

[Optional]
# Enables automatic error capture and alerting via Sentry.
# Recommended for staging and production. Leave blank to disable.
SENTRY_DSN=https://xxxx@oXXXXXX.ingest.sentry.io/XXXXXXX