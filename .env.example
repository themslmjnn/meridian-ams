# =============================================================================
# Meridian AMS — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the required values.

# IMPORTANT:
#   - Never commit .env to version control.
#   - Required: the application refuses to start if missing or invalid.
#   - Optional: has a safe default and can be overridden when needed.
#   - Computed: derived automatically from other variables; do not set directly.

# Environment:
#   development | test | staging | production
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# Required
# Controls logging format, cookie security, API docs, and Prometheus.
# staging uses the same security settings as production.
ENVIRONMENT=development

# Optional
# Accepted Host header values, enforced in staging and production to prevent
# host header injection. Comma-separated.

# Add your Railway domain and any custom domain.
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional
# Origins permitted to make cross-origin requests. Never use "*".
# Comma-separated.

# Add your frontend development server and production URL.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# DATABASE_URL is computed from the variables below.
# Do not set DATABASE_URL directly.

# On Railway, use the individual variables injected by the managed PostgreSQL
# service rather than supplying a full connection string.

# Required
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_NAME=your_database_name

# Optional
# SQLAlchemy connection pool configuration.

# DB_POOL_SIZE     = number of persistent connections kept open
# DB_MAX_OVERFLOW  = additional connections allowed during peak load
# DB_POOL_TIMEOUT  = seconds to wait for a connection from the pool
# DB_POOL_RECYCLE  = seconds before an existing connection is recycled
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600


# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# REDIS_URL is computed from the variables below.
# Do not set REDIS_URL directly.

# Required
REDIS_HOST=localhost
REDIS_PORT=6379

# Optional
# Leave blank for local development without authentication.
REDIS_PASSWORD=

# Required
# Redis database index.

# Convention:
#   0 = development
#   1 = test
#   2 = staging
REDIS_DB=0


# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------

# Required
# Signs and verifies all JWT tokens.

# Generate with:
#   openssl rand -hex 32

# Never reuse the same secret across environments.
JWT_SECRET_KEY=your_jwt_secret_key_minimum_32_characters_long

# Optional
# Used only during JWT secret rotation.
# Accepts tokens signed with the previous key for one access-token lifetime
# (15 minutes), then should be removed.
JWT_SECRET_KEY_PREVIOUS=

# Optional
# Access tokens should remain short-lived; refresh tokens provide session continuity.
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Optional
# Grace period for concurrent refresh requests, such as multiple browser tabs.
# Prevents simultaneous refreshes from unnecessarily triggering token-family
# invalidation.
REFRESH_GRACE_WINDOW_SECONDS=120

# Optional
# Account lockout policy after repeated failed login attempts.
MAX_LOGIN_ATTEMPTS=10
LOCKOUT_DURATION_MINUTES=60

# Optional
# Lifetime of account-activation tokens, in hours.
ACTIVATION_TOKEN_EXPIRES_HOURS=48

# Optional
# Lifetime of email-change verification codes, in minutes.
EMAIL_CHANGE_CODE_EXPIRES_MINUTES=15

# Required
# Signs cursor-pagination tokens.
# Tampered cursors are rejected with HTTP 422.

# Generate with:
#   openssl rand -hex 32
CURSOR_SECRET_KEY=your_cursor_secret_minimum_32_characters_long


# -----------------------------------------------------------------------------
# Users
# -----------------------------------------------------------------------------

# Required
# Email domain enforced for all WORK account registrations.
WORK_EMAIL_DOMAIN=school.edu


# -----------------------------------------------------------------------------
# Grading
# -----------------------------------------------------------------------------

# Optional
# Determines which term types are valid when creating Terms.

# Allowed:
#   semester | quarter | trimester
GRADING_PERIOD_TYPE=semester


# -----------------------------------------------------------------------------
# Workers
# -----------------------------------------------------------------------------

# Optional
# Interval, in seconds, between email-outbox polling cycles.
EMAIL_WORKER_INTERVAL=30

# Optional
# Maximum number of pending email-outbox rows processed per worker cycle.
EMAIL_WORKER_BATCH_SIZE=10

# Optional
# Interval, in seconds, between deletion-worker sweeps for accounts that have passed their grace period.
DELETION_WORKER_INTERVAL=3600


# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
# Used for:
#   - activation invites
#   - forgot-password emails
#   - password-reset emails

# Operational notifications are delivered in-app rather than by email.
# Optional in development/test.
# Required in staging/production.
EMAIL_API_KEY=your_resend_api_key

# Optional
# Must be a verified sender address with the configured email provider.
MAIL_FROM=onboarding@resend.dev

# Optional
MAIL_FROM_NAME=Meridian AMS


# -----------------------------------------------------------------------------
# Mailtrap — Development/Test
# -----------------------------------------------------------------------------
# SMTP configuration for development and test environments.
# Do not use these settings for production email delivery.

# Optional
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=587
MAILTRAP_USERNAME=your_mailtrap_username
MAILTRAP_PASSWORD=your_mailtrap_password


# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------

# Optional
# Enables automatic error capture and alerting through Sentry.
# Recommended for staging and production.
# Leave blank to disable.
SENTRY_DSN=